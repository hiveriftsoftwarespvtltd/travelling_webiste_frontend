# REACT FRONTEND PRODUCTION ENVIRONMENT VARIABLES
# Ise cPanel par upload karne se pehle '.env.production' ko '.env' rename kar dena
# Ya fir apni current .env file mein ye urls replace kar lena

REACT_APP_API_BASE_URL=https://api.jiyolifetravel.com/api

# Flight Backend API Base URL
REACT_APP_FLIGHT_API_BASE_URL=https://api.jiyolifetravel.com/api/flight

# Hotel Backend API Base URL
REACT_APP_HOTEL_API_BASE_URL=https://api.jiyolifetravel.com/api/hotel
